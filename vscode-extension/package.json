{
  "name": "context-engine",
  "displayName": "Context Engine",
  "description": "AI-powered context engineering assistant with RAG pipeline, pruning, and local Ollama models",
  "version": "0.1.0",
  "publisher": "ref",
  "icon": "icon.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/reffobic/context-engine-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "AI",
    "RAG",
    "Ollama",
    "context",
    "coding assistant"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "context-engine-container",
          "title": "Context Engine",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "context-engine-container": [
        {
          "type": "webview",
          "id": "contextEngine.sidebar",
          "name": "Context Engine",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "contextEngine.startServer",
        "title": "Start Backend Server",
        "category": "Context Engine",
        "icon": "$(play)"
      },
      {
        "command": "contextEngine.stopServer",
        "title": "Stop Backend Server",
        "category": "Context Engine",
        "icon": "$(debug-stop)"
      },
      {
        "command": "contextEngine.indexWorkspace",
        "title": "Index Workspace",
        "category": "Context Engine",
        "icon": "$(database)"
      },
      {
        "command": "contextEngine.openSidebar",
        "title": "Open Panel",
        "category": "Context Engine",
        "icon": "$(circuit-board)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "contextEngine.startServer",
          "when": "view == contextEngine.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "contextEngine.stopServer",
          "when": "view == contextEngine.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "contextEngine.indexWorkspace",
          "when": "view == contextEngine.sidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Context Engine",
      "properties": {
        "contextEngine.backendPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for the FastAPI backend server"
        },
        "contextEngine.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter (must have backend dependencies installed)"
        },
        "contextEngine.defaultModel": {
          "type": "string",
          "default": "qwen3.5:9b",
          "description": "Default Ollama model to use for generation"
        },
        "contextEngine.autoStartServer": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the backend server when VS Code opens"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
