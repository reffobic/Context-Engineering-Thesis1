{
  "name": "context-engine",
  "displayName": "Context Engine",
  "description": "AI-powered context engineering assistant with GASR multi-hop graph retrieval, RAG pipeline, pruning, and local Ollama models",
  "version": "0.2.1",
  "publisher": "ref",
  "icon": "icon.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/reffobic/context-engine-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "AI",
    "RAG",
    "Ollama",
    "context",
    "coding assistant"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "context-engine-container",
          "title": "Context Engine",
          "icon": "media/icons/context-engine.svg"
        }
      ]
    },
    "views": {
      "context-engine-container": [
        {
          "type": "webview",
          "id": "contextEngine.sidebar",
          "name": "Context Engine",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "contextEngine.startServer",
        "title": "Start Engine",
        "category": "Context Engine",
        "icon": "$(play)"
      },
      {
        "command": "contextEngine.stopServer",
        "title": "Stop Engine",
        "category": "Context Engine",
        "icon": "$(primitive-square)"
      },
      {
        "command": "contextEngine.indexWorkspace",
        "title": "Index Workspace",
        "category": "Context Engine",
        "icon": "$(database)"
      },
      {
        "command": "contextEngine.indexingInProgress",
        "title": "Indexing Workspace…",
        "category": "Context Engine",
        "icon": "$(sync~spin)",
        "enablement": "false"
      },
      {
        "command": "contextEngine.openSidebar",
        "title": "Focus Agent View",
        "category": "Context Engine"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "contextEngine.startServer",
          "when": "!contextEngine.serverRunning"
        },
        {
          "command": "contextEngine.stopServer",
          "when": "contextEngine.serverRunning"
        },
        {
          "command": "contextEngine.indexWorkspace",
          "when": "contextEngine.serverRunning && !contextEngine.isIndexing"
        },
        {
          "command": "contextEngine.indexingInProgress",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "contextEngine.startServer",
          "when": "view == contextEngine.sidebar && !contextEngine.serverRunning",
          "group": "navigation@1"
        },
        {
          "command": "contextEngine.stopServer",
          "when": "view == contextEngine.sidebar && contextEngine.serverRunning",
          "group": "navigation@1"
        },
        {
          "command": "contextEngine.indexWorkspace",
          "when": "view == contextEngine.sidebar && !contextEngine.isIndexing",
          "group": "navigation@2"
        },
        {
          "command": "contextEngine.indexingInProgress",
          "when": "view == contextEngine.sidebar && contextEngine.isIndexing",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Context Engine",
      "properties": {
        "contextEngine.backendPort": {
          "type": "number",
          "default": 8000,
          "markdownDescription": "Port used by the local Context Engine service (`127.0.0.1`)."
        },
        "contextEngine.pythonPath": {
          "type": "string",
          "default": "python",
          "markdownDescription": "Path to the Python interpreter used to launch the local Context Engine service."
        },
        "contextEngine.defaultModel": {
          "type": "string",
          "default": "qwen3.5:9b",
          "markdownDescription": "Default local Ollama model used for responses and code synthesis."
        },
        "contextEngine.autoStartServer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Automatically start the local Context Engine service when a workspace is opened."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
