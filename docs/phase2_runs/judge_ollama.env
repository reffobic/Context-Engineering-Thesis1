# Phase 2 local Ollama judge — source before CP5 / CP9
#   set -a && source docs/phase2_runs/judge_ollama.env && set +a
#
# Judge ≠ generator (qwen3.5:9b). Tables labeled: local-judge · single-judge
# Do NOT load the judge model while Wave 1 generation still holds the GPU.

# --- Shared Ollama OpenAI-compatible endpoint ---
export OLLAMA_HOST=http://127.0.0.1:11434
export OPENAI_API_KEY=ollama
export OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# --- Locked judge model ---
export PHASE2_JUDGE_MODEL=qwen-7B:latest

# --- SWE-QA (our OpenAI-compatible port; upstream script is Azure-only) ---
export EVAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
export EVAL_LLM_API_KEY=ollama
export EVAL_LLM_API_VERSION=ollama-local
export EVAL_LLM_MODEL_NAME=qwen-7B:latest
# Optional paths filled at CP5:
# export EVAL_REFERENCE_PATH=../external/SWE-QA-Bench/Benchmark/flask.jsonl
# export EVAL_CANDIDATE_DIR=eval_harness/data/reports/phase2_sweqa_candidates
# export EVAL_OUTPUT_DIR=eval_harness/data/reports/phase2_sweqa_scores
# export EVAL_REPO_FILTER=flask,requests,pytest
# export EVAL_MAX_WORKERS=1

# --- RepoProbe scorer.py ---
export OPENAI_SCORING_API_KEY=ollama
export OPENAI_SCORING_BASE_URL=http://127.0.0.1:11434/v1
export SCORING_MODEL=qwen-7B:latest
