# Paid Sonnet judge via OpenRouter — copy to ~/haya/api_judge.env (mode 600).
# Do NOT commit the real file. Do NOT put OPENROUTER_* or HARNESS_PROVIDER_* names here
# (some scoring wrappers abort if env *names* match openrouter|paid).
#
#   umask 077
#   cp docs/phase2_runs/judge_openrouter.env.example ~/haya/api_judge.env
#   # edit ~/haya/api_judge.env and paste the thesis-judge key once

# SWE-QA 5-dim judge
export EVAL_LLM_BASE_URL='https://openrouter.ai/api/v1'
export EVAL_LLM_API_KEY='paste-judge-key-here'
export EVAL_LLM_MODEL_NAME='anthropic/claude-sonnet-4.5'
export PHASE2_JUDGE_MODEL='anthropic/claude-sonnet-4.5'
export EVAL_LLM_TIMEOUT=600
# Optional parallelism (rate limits may force 1–2)
export EVAL_MAX_WORKERS=2

# RepoProbe checklist scorer (same key/model)
export OPENAI_SCORING_BASE_URL='https://openrouter.ai/api/v1'
export OPENAI_SCORING_API_KEY="$EVAL_LLM_API_KEY"
export SCORING_MODEL='anthropic/claude-sonnet-4.5'
